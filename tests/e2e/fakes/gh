#!/usr/bin/env python3
"""Read-only fake for the exact GitHub argv emitted by production adapters."""

import json
import os
from pathlib import Path
import sys


STATE = Path(os.environ["GH_FAKE_STATE"])
ARGS = sys.argv[1:]
state = json.loads(STATE.read_text())


def save():
    temporary = STATE.with_suffix(".tmp")
    temporary.write_text(json.dumps(state, sort_keys=True))
    os.replace(temporary, STATE)


def emit(value, code=0):
    print(json.dumps(value, sort_keys=True))
    raise SystemExit(code)


state["read_calls"].append(ARGS)
save()

if ARGS == ["--version"]:
    print("gh version 2.80.0")
    raise SystemExit(0)
if ARGS == ["auth", "status", "--json", "active,login"]:
    emit({"active": True, "login": "fixture-user"})
if len(ARGS) == 2 and ARGS[0] == "api" and ARGS[1].startswith("repos/"):
    repository = ARGS[1].removeprefix("repos/")
    if "/pulls" not in repository:
        record = state["repositories"][repository]
        emit({"full_name": repository, "visibility": record.get("visibility", "private"), "default_branch": record["default_branch"]})
if len(ARGS) == 2 and ARGS[0] == "api" and ARGS[1].endswith("/pulls?state=all"):
    emit([])
if len(ARGS) > 2 and ARGS[:2] == ["api", "graphql"]:
    owner = next(value.split("=", 1)[1] for value in ARGS if value.startswith("owner="))
    name = next(value.split("=", 1)[1] for value in ARGS if value.startswith("name="))
    repository = f"{owner}/{name}"
    emit({"data": {"repository": {"nameWithOwner": repository, "owner": {"projectsV2": {"nodes": []}}}}})
if "-X" in ARGS or any(word in " ".join(ARGS).lower() for word in ("merge", "create", "push", "deploy")):
    state = json.loads(STATE.read_text())
    state["prohibited_events"].append(ARGS)
    temporary = STATE.with_suffix(".tmp")
    temporary.write_text(json.dumps(state, sort_keys=True))
    os.replace(temporary, STATE)
emit({"error": "unsupported argv"}, 2)
